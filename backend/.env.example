# TGZ LIFESTEAL BACKEND CONFIGURATION
PORT=3000
HOST=0.0.0.0

# REQUIRED: Initial bootstrap password for initial admin provisioning ONLY
# Once changed, the new password is saved permanently and this bootstrap value is ignored
ADMIN_BOOTSTRAP_PASSWORD=TgzAdminInitial2026!Secure

# Configured Administrator IDs (comma-separated, preserves sg_karthi)
ADMIN_USER_IDS=sg_karthi,dhanush,lmtg,darksight

# PERSISTENT PRODUCTION DATABASE CONFIGURATION (RECOMMENDED FOR VERCEL DEPLOYMENTS)
# Set ONE of the following options in your Vercel Environment Variables:
# Option A: Cloud KV / Upstash Redis REST (Zero dependencies, ideal for Vercel)
# KV_REST_API_URL=https://your-upstash-instance.upstash.io
# KV_REST_API_TOKEN=your-upstash-token
# Option B: Turso Cloud SQLite
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-turso-token
# Option C: PostgreSQL (Neon / Supabase / Railway)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# App Version & Automatic Updater
APP_VERSION_CODE=1
APP_VERSION_NAME=1.0
APP_APK_URL=https://github.com/sgkarthi1910-rgb/MC-App/releases/download/v1.0.0/TGZ-Lifestyle-v1.0.apk

# Minecraft SMP Server
MINECRAFT_SERVER_HOST=node2.vyroxsmp.online
MINECRAFT_SERVER_PORT=10010
MINECRAFT_BEDROCK_PORT=10011

# Discord Integration
DISCORD_INVITE_URL=https://discord.gg/J5P89mxXbc

# Minecraft Plugin Ingestion Secret Key (used by server plugin to push player stats)
MINECRAFT_PLUGIN_API_KEY=tgz_plugin_sec_99a8b7c6d5e4f3a2

# Session expiration in days
SESSION_EXPIRATION_DAYS=30
